# Copy this file to .env (local dev) or .env on the VM (production) and fill in real values.
# Never commit the real .env file.

# --- Database ---
POSTGRES_USER=terrarosa
# "devpass" is fine for local dev (matches what start-dev.sh uses when it
# creates the terra-rosa-db container). Generate a real random value before
# deploying anywhere reachable — see "Known placeholders" below.
POSTGRES_PASSWORD=devpass
POSTGRES_DB=terrarosa

# Full connection string used by the app. For local dev without Docker, use
# localhost. When running via docker-compose, change this to the service name
# "db" in the container environment.
DATABASE_URL=postgres://terrarosa:devpass@localhost:5432/terrarosa

# --- Sessions / auth ---
# Random long string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32-output


# --- First admin user (used by db:seed, only on first run) ---
SEED_ADMIN_NAME=Bert
SEED_ADMIN_EMAIL=admin@terrarosa.org
SEED_ADMIN_PASSWORD=change-me-before-first-run

# --- Caddy / domain (production only) ---
# Domain Caddy will request a TLS certificate for. In production this is
# terrarosa.org; keep "localhost" for local dev so Caddy doesn't try to issue
# a real certificate.
DOMAIN=localhost
